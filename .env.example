# Root .env.example - Copy this to create your .env files

# Backend variables (copy to backend/.env) UNICAS VARIABLES OBLIGATORIAS, RECOMENDABLE USAR ATLAS.
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/<db>?retryWrites=true&w=majority
DB_NAME=attendance_db

# Optional defaults for device
DEVICE_ID=default
DEVICE_TYPE=webcam
DEVICE_WIDTH=640
DEVICE_HEIGHT=480
DEVICE_FPS=30
DEBOUNCE_SECONDS=300

# App
APP_VERSION=0.1.0

# Frontend variables (copy to frontend/.env)
# VITE_API_BASE_URL=http://localhost:8000
