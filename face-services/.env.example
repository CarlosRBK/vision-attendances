# Face Services Configuration

# VIDEO_SOURCE puede ser:
# - Un número (0, 1, 2...) para cámara física local (NO TESTEADO)
# - Una URL para stream HTTP: http://localhost:5000/video_feed
# - Una URL RTSP: rtsp://username:password@ip:port/stream (NO TESTEADO)

# Para usar con camera-stream (recomendado):
VIDEO_SOURCE=http://host.docker.internal:5000/video_feed

# Para cámara física local (solo si NO usas Docker) (NO TESTEADO):
# VIDEO_SOURCE=0
